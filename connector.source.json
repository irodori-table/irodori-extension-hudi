{
  "schemaVersion": 1,
  "extensionId": "irodori.hudi",
  "visibility": "public",
  "version": "0.1.1",
  "connector": {
    "id": "hudi.connector",
    "engine": "hudi",
    "label": "Hudi",
    "aliases": [
      "hudi",
      "Apache Hudi",
      "Hudi"
    ],
    "defaultPort": 443,
    "wire": "lakehouse",
    "module": "hudi.driver",
    "features": [
      "metadata",
      "sql"
    ]
  },
  "connection": {
    "endpoint": {
      "modes": [
        "catalog",
        "objectStorage",
        "jdbc",
        "connectionString"
      ],
      "defaultPort": 443,
      "fields": [
        {
          "id": "catalogType",
          "label": "Catalog type",
          "type": "string",
          "option": "catalogType",
          "default": "filesystem",
          "required": true
        },
        {
          "id": "catalogUri",
          "label": "Catalog URI",
          "type": "uri",
          "option": "catalogUri"
        },
        {
          "id": "warehouse",
          "label": "Warehouse path",
          "type": "string",
          "option": "warehouse"
        },
        {
          "id": "tablePath",
          "label": "Table path",
          "type": "string",
          "option": "tablePath"
        },
        {
          "id": "storageBackend",
          "label": "Storage backend",
          "type": "string",
          "option": "storageBackend",
          "default": "objectStorage"
        },
        {
          "id": "region",
          "label": "Cloud region",
          "type": "string",
          "option": "region"
        },
        {
          "id": "credentialVending",
          "label": "Credential vending",
          "type": "boolean",
          "option": "credentialVending",
          "default": false
        }
      ]
    },
    "authMethods": [
      "none",
      "connectionString",
      "awsDefaultCredentialsChain",
      "awsSigV4",
      "awsProfile",
      "awsSso",
      "webIdentity",
      "awsAssumeRole",
      "sessionToken",
      "oauth2",
      "catalogBearerToken",
      "catalogPassword",
      "serviceAccountJson",
      "serviceAccountJwt",
      "serviceAccountImpersonation",
      "googleApplicationDefaultCredentials",
      "workloadIdentity",
      "azureAd",
      "servicePrincipal",
      "servicePrincipalCertificate",
      "managedIdentity",
      "sasToken",
      "customDriverOptions"
    ],
    "tls": "required",
    "transports": "default",
    "optionNamespaces": [
      "lakehouse",
      "hudi",
      "aws",
      "catalog",
      "objectStorage"
    ],
    "customDriverOptions": true
  },
  "runtime": {
    "driverLinked": true
  },
  "source": {
    "knowledgeEngineStatus": "recognized_no_connector",
    "adapter": null
  }
}
